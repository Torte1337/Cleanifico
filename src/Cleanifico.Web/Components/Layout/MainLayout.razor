@inherits LayoutComponentBase

<div class="app-frame">
    <aside class="sidebar">
        <a class="brand" href="/" aria-label="Cleanifico Office Startseite">
            <span class="brand-mark">C</span>
            <span>
                <strong>Cleanifico</strong>
                <small>Office</small>
            </span>
        </a>

        <nav aria-label="Hauptnavigation">
            <AuthorizeView Policy="@SecurityPolicies.OfficeAccess">
                <NavLink href="/" Match="NavLinkMatch.All">
                    <span class="nav-icon" aria-hidden="true">⌂</span>
                    Übersicht
                </NavLink>
            </AuthorizeView>
            <AuthorizeView Policy="@SecurityPolicies.ViewCleaningTypes">
                <NavLink href="/reinigungstypen">
                    <span class="nav-icon" aria-hidden="true">◇</span>
                    Reinigungstypen
                </NavLink>
            </AuthorizeView>
            <AuthorizeView Policy="@SecurityPolicies.ViewTimeTypes">
                <NavLink href="/zeittypen">
                    <span class="nav-icon" aria-hidden="true">◷</span>
                    Zeittypen
                </NavLink>
            </AuthorizeView>
            <AuthorizeView Policy="@SecurityPolicies.AdministrationAccess">
                <p class="nav-section">Administration</p>
                <NavLink href="/administration/benutzer">
                    <span class="nav-icon" aria-hidden="true">♙</span>
                    Benutzer
                </NavLink>
            </AuthorizeView>
        </nav>

        <p class="sidebar-note">Betriebssoftware für Gebäudereinigung</p>
    </aside>

    <section class="workspace">
        <header class="topbar">
            <span>Cleanifico Office</span>
            <AuthorizeView>
                <Authorized Context="userContext">
                    <div class="user-menu">
                        <span>@userContext.User.Identity?.Name</span>
                        <form method="post" action="/auth/logout">
                            <AntiforgeryToken />
                            <button type="submit">Abmelden</button>
                        </form>
                    </div>
                </Authorized>
            </AuthorizeView>
        </header>
        <div class="page-container">
            @Body
        </div>
    </section>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ein unerwarteter Fehler ist aufgetreten.
    <a href="." class="reload">Neu laden</a>
    <span class="dismiss">🗙</span>
</div>
